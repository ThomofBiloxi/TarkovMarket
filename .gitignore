# --- Python Cache & Compiled files ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- PyInstaller Files ---
# Distribution directory
dist/
# Build directory
build/
# Spec file
*.spec

# --- User Data ---
# Exclude the user-specific database file (it's generated at runtime)
tarkov_data.db
# If platformdirs creates subfolders within the user data path,
# you generally don't ignore the top-level directory itself here,
# but rather ensure the DB file *within* it is ignored if it could
# accidentally end up in the repo root. The DB file should only ever
# be created in the location specified by utils.get_user_data_dir().

